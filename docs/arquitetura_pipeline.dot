digraph G {
  graph [fontname="Helvetica"];
  rankdir=TB; dpi=300; bgcolor="white"; nodesep=0.35; ranksep=0.55;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, penwidth=1.2, margin="0.18,0.10"];
  edge [color="#555555", penwidth=1.3, arrowsize=0.7, fontname="Helvetica", fontsize=9];

  subgraph cluster_src { label="Fontes (Portal Dados Abertos do Recife)"; style="rounded,dashed"; color="#999999"; fontsize=10;
    s1 [label="Base 1\nSinistros CTTU\n(CSV anual)", fillcolor="#EEF1F5", color="#8A97A8"];
    s2 [label="Base 2 (opcional)\nVelocidade / Fotossensores\n(janelas de 15 min)", fillcolor="#FFFFFF", color="#8A97A8", style="rounded,dashed"];
    s3 [label="Base 3 (opcional)\nMalha cicloviária e\ncorredores de ônibus", fillcolor="#FFFFFF", color="#8A97A8", style="rounded,dashed"];
  }
  bronze [label="BRONZE\ndata/raw\n\n10 CSVs CTTU 2015–2024 intocados\n72.255 chamados · 21,7 MB\nVolumetria e dicionário\n(F2)", fillcolor="#F3E3D3", color="#B07A4B"];
  silver [label="SILVER\ndata/processed\n\nHarmoniza 3 layouts anuais\nRemove cancelados e duplicidades\n92 bairros oficiais + não informado\nFeature Eng.: turno, pico, UPS\n60.225 sinistros\n(F3)", fillcolor="#E6E9EC", color="#7D8791"];
  gold   [label="GOLD\ndata/processed/gold\n\n5 tabelas analíticas:\nsérie temporal · top 10 bairros\ndia×hora · modais · clima×via\n(F4)", fillcolor="#F6EBC8", color="#B8962E"];
  out    [label="Consumo\n\nGráficos 300 DPI (F5)\nRelatório ABNT (F6)\nPitch / Slides", fillcolor="#E3EEE6", color="#5E8B6B"];
  orq    [label="Orquestrador  src/pipeline.py  (F1)\ncaminhos relativos (pathlib) · contratos de dados · métricas JSON", shape=box, style="filled", fillcolor="#2F3B4C", fontcolor="white", color="#2F3B4C", fontsize=10];

  {rank=same; bronze; orq}
  s1 -> bronze; s2 -> bronze [style=dashed]; s3 -> bronze [style=dashed];
  bronze -> silver [label=" validar_bronze "];
  silver -> gold [label=" validar_silver "];
  gold -> out [label=" validar_gold "];
  orq -> bronze [constraint=false, style=dashed, arrowhead=none, color="#2F3B4C"];
  orq -> silver [constraint=false, style=dashed, arrowhead=none, color="#2F3B4C"];
  orq -> gold [constraint=false, style=dashed, arrowhead=none, color="#2F3B4C"];
  
}
